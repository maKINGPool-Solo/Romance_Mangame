%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 644aedb8eb5027142810577af515b913, type: 3}
  m_Name: E9
  m_EditorClassIdentifier: Assembly-CSharp::Dial
  dials:
  - talker: -1
    listener: -1
    face: 0
    text: "\uD55C\uB098\uC640 \uC5F0\uC544\uAC00 \uB3D9\uC2DC\uC5D0 \uB0B4 \uC55E\uC73C\uB85C
      \uB2E4\uAC00\uC628\uB2E4."
  - talker: 0
    listener: 0
    face: 0
    text: "\"...\uC5B4?\""
  - talker: 0
    listener: 0
    face: 0
    text: "\"...\uC5F0\uC544?\""
  - talker: 2
    listener: 0
    face: 0
    text: "\"\uC557! \uD55C\uB098?\""
  - talker: 2
    listener: 0
    face: 0
    text: "\"...\uC65C \uC5EC\uAE30 \uC788\uC5B4?\""
  - talker: 0
    listener: 0
    face: 0
    text: "\"\uC124\uB9C8...\""
  - talker: 2
    listener: 0
    face: 0
    text: "\"\uC6B0\uB9AC \uB458 \uB2E4 \uACE0\uBC31\uD558\uB7EC \uC628 \uAC70\uC57C?!\""
  - talker: -1
    listener: 0
    face: 0
    text: "\uC7A0\uC2DC \uC815\uC801\uC774 \uD750\uB978\uB2E4."
  - talker: -1
    listener: 0
    face: 0
    text: "\uD55C\uB098\uC640 \uC5F0\uC544\uAC00 \uB3D9\uC2DC\uC5D0 \uB098\uB97C
      \uBC14\uB77C\uBCF8\uB2E4."
  - talker: 0
    listener: 0
    face: 0
    text: "\"...\uD765!\""
  - talker: 0
    listener: 0
    face: 0
    text: "\"\uC774\uB807\uAC8C \uB41C\uAC70, \uAE4C\uC9D3\uAC70 \uB0B4\uAC00 \uBA3C\uC800
      \uB9C8\uC74C\uC744 \uC0AC\uB85C\uC7A1\uC73C\uBA74 \uB3FC!  \uB0B4 \uB514\uC800\uD2B8\uB791
      \uADF8\uB9BC\uC73C\uB85C \uC774\uAE38\uAC70\uC57C!\""
  - talker: 0
    listener: 0
    face: 0
    text: "\"\uAC01\uC624\uD574, \uC5F0\uC544!\""
  - talker: 2
    listener: 0
    face: 0
    text: "\"\uD558! \uADF8\uB807\uAC8C \uB098\uC624\uACA0\uB2E4 \uC774\uAC70\uC9C0!\""
  - talker: 2
    listener: 0
    face: 0
    text: "\"\uB098\uB3C4 \uC9C8 \uC218 \uC5C6\uC9C0! \uB0B4 \uD53C\uC9C0\uCEEC\uACFC
      \uC5F4\uC815\uC73C\uB85C \uBA3C\uC800 \uB9C8\uC74C\uC744 \uC0AC\uB85C\uC7A1\uC744\uAC70\uC57C!\""
  - talker: 2
    listener: 0
    face: 0
    text: "\"\uC815\uC815\uB2F9\uB2F9\uD558\uAC8C \uC2B9\uBD80\uB97C \uBCF4\uC790,
      \uD55C\uB098!\""
  - talker: -1
    listener: 0
    face: 0
    text: "\uB458\uC740 \uC11C\uB85C\uB97C \uB9C8\uC8FC \uBCF4\uBA70 \uC529 \uC6C3\uC5C8\uB2E4."
  - talker: -1
    listener: 0
    face: 0
    text: "...\uC660\uC9C0 \uC55E\uC73C\uB85C\uB3C4 \uB9E4\uC77C \uC2DC\uB04C\uBC85\uC801\uD560
      \uAC83 \uAC19\uB2E4."
  - talker: -1
    listener: 0
    face: 0
    text: "<GOOD END - \uCD5C\uACE0\uC758 \uB77C\uC774\uBC8C>"
  choices: []
