%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 644aedb8eb5027142810577af515b913, type: 3}
  m_Name: DIal_10 2
  m_EditorClassIdentifier: Assembly-CSharp::Dial
  dials:
  - talker: -1
    listener: 2
    face: 0
    text: "\uC5F0\uC544\uAC00 \uBC14\uB2E5\uC744 \uB4A4\uC801\uAC70\uB9AC\uBA70 \uBB34\uC5B8\uAC00\uB97C
      \uCC3E\uACE0 \uC788\uB2E4."
  - talker: -1
    listener: 2
    face: 0
    text: "\uAC00\uBC29\uC744 \uC5F4\uC5C8\uB2E4 \uB2EB\uC558\uB2E4 \uD558\uBA70
      \uC548\uC5D0 \uC788\uB294 \uBB3C\uAC74\uC744 \uD558\uB098\uC529 \uAEBC\uB0B4
      \uB193\uB294\uB2E4."
  - talker: -1
    listener: 2
    face: 0
    text: "\"...\uBB50 \uCC3E\uB294 \uAC70\uC57C?\""
  - talker: 2
    listener: 2
    face: 0
    text: "\"\uC544..! \uC548\uB155! \uADF8 \uC5B4..\""
  - talker: 2
    listener: 2
    face: 0
    text: "\"\uB0B4 \uD559\uC0DD\uC99D\uC774.. \uC548\uBCF4\uC5EC\uC11C...\""
  - talker: -1
    listener: 2
    face: 0
    text: "\"\uBB50? \uADF8 \uC911\uC694\uD55C \uAC78?! \uADF8\uAC70 \uC5C6\uC73C\uBA74
      \uD559\uAD50 \uBC16\uC73C\uB85C \uB098\uAC00\uC9C0\uB3C4 \uBABB\uD560\uD150\uB370!\""
  - talker: 2
    listener: 2
    face: 0
    text: "\"(\uB4A4\uC801\uB4A4\uC801\uAC70\uB9AC\uBA70) \uADFC\uB370 \uAC71\uC815\uB9C8!
      \uAE08\uBC29 \uCC3E\uC744 \uC218 \uC788\uC744 \uAC70\uC57C!\""
  - talker: -1
    listener: 2
    face: 0
    text: "\uC5B4\uB290\uC0C8 \uAC00\uBC29 \uBD80\uD53C\uC758 \uB450 \uBC30\uB294
      \uB418\uC5B4 \uBCF4\uC774\uB294 \uC7A1\uB3D9\uC0AC\uB2C8\uB4E4\uC774 \uBC14\uB2E5\uC5D0
      \uC9C0\uC800\uBD84\uD558\uAC8C \uB110\uBE0C\uB7EC\uC84C\uB2E4."
  choices:
  - text: "\"\uAC19\uC774 \uCC3E\uC544\uC904\uAC8C.\""
    good:
    - talker: 2
      listener: 2
      face: 2
      text: "\"\uC5B4 \uC9C4\uC9DC?? \uACE0\uB9C8\uC6CC!\""
    - talker: -1
      listener: 2
      face: 2
      text: "\"\uB10C \uACC4\uC18D \uAC00\uBC29 \uC548\uCABD\uC744 \uCC3E\uC544.
        \uB09C \uB108\uAC00 \uAC14\uC744\uBC95\uD55C \uB2E4\uB978 \uC7A5\uC18C\uB4E4\uC5D0\uC11C
        \uCC3E\uC544\uBCFC\uAC8C!\""
    - talker: -1
      listener: 2
      face: 2
      text: "\"\uC6C5, \uACE0\uB9C8\uC6CC! \uC5ED\uC2DC \uB10C \uC815\uB9D0 \uBBFF\uC74C\uC9C1\uD574!"
    bad:
    - talker: -1
      listener: 2
      face: 2
      text: "\"\uC5B4 \uC9C4\uC9DC?? \uACE0\uB9C8\uC6CC!\""
    - talker: -1
      listener: 2
      face: 0
      text: "\"\uC5F0\uC544\uB294 \uC6CC\uB099\uC5D0 \uB364\uBC99\uB300\uB2C8\uAE4C
        \uC5B4\uB514 \uD758\uB9AC\uACE0 \uC654\uC744 \uAC70 \uAC19\uC740\uB370.\" "
    - talker: -1
      listener: 2
      face: 1
      text: "\"(\uC7A5\uB09C\uC2A4\uB7FD\uAC8C) \uC5B4\uB514 \uB0C9\uC7A5\uACE0 \uC548\uC5D0
        \uB123\uAC70\uB098 \uBAA8\uB974\uACE0 \uBC84\uB9B0\uAC70 \uC544\uB2C8\uC57C?\" "
    - talker: 2
      listener: 2
      face: 1
      text: "\"(\uC12D\uC12D\uD574\uD558\uBA70) \uC57C...\uB098 \uADF8\uB807\uAC8C
        \uB364\uBC99\uB300\uC9C0\uB294 \uC548\uAC70\uB4E0..!\""
    - talker: 2
      listener: 2
      face: 1
      text: "\"\uADF8\uB807\uAC8C \uB098 \uACC4\uC18D \uBB34\uC2DC\uD560\uAC70\uBA74
        \uADF8\uB0E5 \uAC00! \uB098 \uD63C\uC790 \uCC3E\uC744\uAC70\uC57C!\""
  - text: "\"\uADF8\uB0E5 \uAC00\uBC29 \uC548\uC5D0 \uC788\uB294 \uAC70 \uC804\uBD80
      \uAEBC\uB0B4\uBD10.\""
    good:
    - talker: 2
      listener: 2
      face: 2
      text: "\"\uC624! \uCC9C\uC7AC!\""
    - talker: 2
      listener: 2
      face: 2
      text: "\uC5F0\uC544\uB294 \uAC00\uBC29\uC744 \uB4A4\uC9D1\uC5B4 \uC548\uC5D0
        \uB0B4\uC6A9\uBB3C\uC744 \uC640\uB974\uB974 \uC3DF\uC544\uB0C8\uB2E4. "
    - talker: -1
      listener: 2
      face: 2
      text: "\"\uC544 \uC800\uAE44\uB2E4!\""
    - talker: 2
      listener: 2
      face: 2
      text: "\"\uC544 \uADF8\uB7EC\uB124, \uB0B4 \uD559\uC0DD\uC99D! \uCC3E\uC544\uC918\uC11C
        \uACE0\uB9C8\uC6CC!!\" "
    bad:
    - talker: 2
      listener: 2
      face: 2
      text: "\"\uC624 \uCC9C\uC7AC!\""
    - talker: 0
      listener: 2
      face: 2
      text: "\uC5F0\uC544\uB294 \uAC00\uBC29\uC744 \uB4A4\uC9D1\uC5B4 \uC548\uC5D0
        \uB0B4\uC6A9\uBB3C\uC744 \uC640\uB974\uB974 \uC3DF\uC544\uB0C8\uB2E4. "
    - talker: 2
      listener: 2
      face: 0
      text: "\uC5F0\uC544\uC758 \uBB3C\uAC74\uB4E4\uC740 \uC6B4\uB3D9\uC7A5 \uBAA8\uB798\uAC00
        \uBB3B\uC73C\uBA70 \uAE08\uC0C8 \uB354\uB7EC\uC6CC\uC84C\uB2E4."
    - talker: 2
      listener: 2
      face: 1
      text: "\"\uC544.. \uC544? \uC5C6\uC5B4..\" "
    - talker: 2
      listener: 2
      face: 1
      text: "\"\uAD1C\uD788 \uB0B4 \uB2E4\uB978 \uBB3C\uAC74\uB4E4\uB9CC \uBAA8\uB798\uAC00
        \uC794\uB729 \uBB3B\uC5C8\uB124..\u3160\""
    - talker: 2
      listener: 2
      face: 1
      text: "\"\uB3C4\uC640\uC8FC\uB824\uACE0 \uD574\uC11C \uACE0\uB9C8\uC6CC.. \uADFC\uB370
        \uB098 \uD63C\uC790\uC11C \uCC3E\uC544\uBCFC\uAC8C...\""
  - text: "\"\uB2E4\uC74C\uC5D0 \uCC3E\uC544\uBCF4\uC790.\""
    good:
    - talker: -1
      listener: 2
      face: 2
      text: "\"\uC6B0\uC120 \uD0DC\uAE45\uC740 \uB0B4\uAC00 \uB3C4\uC640\uC904\uAC8C.
        \uD559\uC0DD\uC99D\uC740 \uB2E4\uC74C\uC5D0 \uCC3E\uC544\uBCF4\uC790!\""
    - talker: 2
      listener: 2
      face: 2
      text: "\"(\uBCFC\uC744 \uBD89\uD788\uBA70) \uC544.. \uC9C4\uC9DC..?\""
    - talker: 2
      listener: 2
      face: 2
      text: "\"\uADF8\uB807\uAC8C \uC548\uD574\uC918\uB3C4 \uB418\uB294\uB370.. \uC751!
        \uADF8\uB7EC\uBA74 \uB098\uC57C \uACE0\uB9D9\uC9C0!!\""
    - talker: -1
      listener: 2
      face: 2
      text: "\uADF8\uB807\uAC8C \uD558\uB8E8\uC885\uC77C \uC5F0\uC544\uC640 \uBD99\uC5B4\uB2E4\uB2C8\uBA70
        \uD0DC\uAE45\uC744 \uB3C4\uC640\uC92C\uB2E4."
    bad:
    - talker: -1
      listener: 2
      face: 0
      text: "\"\uC6B0\uC120 \uD0DC\uAE45\uC740 \uB0B4\uAC00 \uB3C4\uC640\uC904\uAC8C.
        \uD559\uC0DD\uC99D\uC740 \uB2E4\uC74C\uC5D0 \uCC3E\uC544\uBCF4\uC790!\""
    - talker: 2
      listener: 2
      face: 0
      text: "\"\uC544, \uC751! \uACE0\uB9C8\uC6CC!!\""
    - talker: -1
      listener: 2
      face: 0
      text: "(\uC7A0\uC2DC \uD6C4)"
    - talker: -1
      listener: 2
      face: 1
      text: "\"\uC557.. \uC5B4\uB5A1\uD558\uC9C0.. \uC5F0\uC544 \uD0DC\uAE45 \uB3C4\uC640\uC8FC\uB294
        \uAC70 \uAE4C\uBA39\uC5B4\uBC84\uB838\uB2E4!\" "
    - talker: -1
      listener: 2
      face: 1
      text: "\uC11C\uB458\uB7EC \uC5F0\uC544\uAC00 \uC788\uC5C8\uB358 \uC6B4\uB3D9\uC7A5\uC5D0
        \uAC00\uBD24\uB354\uB2C8 \uC774\uBBF8 \uC5F0\uC544\uB294 \uC0AC\uB77C\uC838\uC788\uC5C8\uB2E4. "
