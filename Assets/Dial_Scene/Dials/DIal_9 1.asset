%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 644aedb8eb5027142810577af515b913, type: 3}
  m_Name: DIal_9 1
  m_EditorClassIdentifier: Assembly-CSharp::Dial
  dials:
  - talker: -1
    listener: 1
    face: 0
    text: "\uB179\uC2A4\uAC00 \uCC3D\uBC16\uC744 \uAC00\uB9CC\uD788 \uBC14\uB77C\uBCF4\uACE0
      \uC788\uB2E4."
  - talker: -1
    listener: 1
    face: 0
    text: "\uD3C9\uC18C\uCC98\uB7FC \uAD49\uC7A5\uD788 \uC2EC\uAC01\uD55C \uD45C\uC815\uC774\uB2E4."
  - talker: 1
    listener: 1
    face: 0
    text: "\"...\uC624\uB298\uC740 \uBC14\uB78C\uC774 \uC8FD\uC5B4 \uC788\uAD70.\""
  - talker: -1
    listener: 1
    face: 0
    text: "\"...\uBB50 \uD574?\""
  - talker: -1
    listener: 1
    face: 0
    text: "\uB179\uC2A4\uAC00 \uCC9C\uCC9C\uD788 \uACE0\uAC1C\uB97C \uB3CC\uB9B0\uB2E4."
  - talker: 1
    listener: 1
    face: 0
    text: "\"...\uAE30\uB2E4\uB9AC\uB294 \uC911\uC774\uB2E4.\""
  - talker: -1
    listener: 1
    face: 0
    text: "\"\uBB58?\""
  - talker: -1
    listener: 1
    face: 0
    text: "\uB179\uC2A4\uAC00 \uB2E4\uC2DC \uCC3D\uBC16\uC744 \uBC14\uB77C\uBCF8\uB2E4."
  - talker: -1
    listener: 1
    face: 0
    text: "(\uC9C4\uC9C0\uD55C \uD45C\uC815\uC73C\uB85C) \"...\uC544\uC9C1\uC740
      \uB9D0\uD560 \uC218 \uC5C6\uB2E4.\" "
  choices:
  - text: "\"\uB098\uB3C4 \uAC19\uC774 \uAE30\uB2E4\uB9B4\uB798.\""
    good:
    - talker: 1
      listener: 1
      face: 2
      text: "\"\uD760...\uD765\uBBF8\uB86D\uAD70.\""
    - talker: 1
      listener: 1
      face: 2
      text: "\"\uB108 \uB610\uD55C \uB9D0\uD558\uC9C0 \uBABB\uD560 \uC0AC\uC5F0\uC774
        \uC788\uB294 \uAC83 \uAC19\uAD70... .\uC774 \uCE68\uBB35\uC744 \uB204\uAD70\uAC00\uC640
        \uD568\uAED8 \uAE30\uB2E4\uB9AC\uB294 \uAC83\uB3C4 \uB098\uC058\uC9C0 \uC54A\uACA0\uC5B4.\""
    - talker: -1
      listener: 1
      face: 2
      text: "\uB2E4\uC74C \uC218\uC5C5\uC2DC\uAC04\uAE4C\uC9C0 \uB458\uC740 \uD568\uAED8
        \uCC3D\uC744 \uBC14\uB77C\uBCF8\uB2E4. \uBE44\uC7A5\uD55C \uD45C\uC815\uC73C\uB85C
        \uC6B0\uB9B0 \uACE0\uAC1C\uB97C \uB044\uB355\uC774\uBA70 \uCC3D \uBC16\uC758
        \uAE4A\uC740 \uD48D\uACBD\uC744 \uAC10\uC0C1\uD55C\uB2E4.  "
    bad:
    - talker: 1
      listener: 1
      face: 1
      text: "\"....\uB124\uAC00?\""
    - talker: -1
      listener: 1
      face: 1
      text: "\"\uC74C... \uC544\uB0D0. \""
    - talker: 1
      listener: 1
      face: 1
      text: "\"...\uC774\uB7F0 \uBB34\uAC8C\uB97C \uACAC\uB51C \uC218 \uC788\uC744
        \uAC83 \uAC19\uC9C4 \uC54A\uC740\uB370.\""
    - talker: 1
      listener: 1
      face: 1
      text: "\"\uC774 \uAE4A\uC740 \uC0AC\uBA85\uC740 \uB098 \uD558\uB098\uB9CC\uC774
        \uBC1B\uB4E4\uAE30\uC5D0 \uCDA9\uBD84\uD574.\""
  - text: "\"\uB108 \uB610 \uD63C\uC790 \uCEE8\uC149 \uC7A1\uACE0 \uC788\uB294 \uAC70\uC57C?\""
    good:
    - talker: 1
      listener: 1
      face: 2
      text: "\"\uCEE8\uC149. \uCEE8\uC149\uC774\uB77C...\""
    - talker: 1
      listener: 1
      face: 2
      text: "\"\uADF8\uB798, \uCEE8\uC149\uC77C\uC218\uB3C4. \uC774 \uBAA8\uB4E0
        \uAC8C \uCEE8\uC149\uC774\uB77C \uD574\uC11D\uD558\uBA74 \uC774\uD574\uD558\uAE30\uAC00
        \uC26C\uC6CC\uC9C0\uC9C0.\""
    - talker: 1
      listener: 1
      face: 2
      text: "\"\uACE0\uB9D9\uB2E4. \uB108 \uB355\uBD84\uC5D0 \uC774 \uAE30\uB2E4\uB9BC\uC774
        \uC218\uC6D4\uD574\uC84C\uC5B4.\" "
    - talker: -1
      listener: 1
      face: 2
      text: "\uC774\uD574\uB294 \uBABB\uD588\uC9C0\uB9CC \uB179\uC2A4\uB294 \uC88B\uAC8C
        \uBC1B\uC544\uB4E4\uC778 \uAC83 \uAC19\uB2E4."
    bad:
    - talker: 1
      listener: 1
      face: 1
      text: '"..."'
    - talker: 1
      listener: 1
      face: 1
      text: "\"...\uC544\uC9C1\uC740 \uC548 \uB41C\uB2E4.\""
    - talker: 1
      listener: 1
      face: 1
      text: "\"\uB610 \uB098\uB97C \uC6B0\uC2B5\uAC8C \uC5EC\uAE30\uB294 \uAC83\uC778\uAC00..?\""
    - talker: 1
      listener: 1
      face: 1
      text: "\"\uB9D0\uC744 \uC544\uB07C\uB294 \uBC95\uBD80\uD130 \uBC30\uC6B0\uB3C4\uB85D.\""
  - text: "\"\uADF8\uB7FC \uB09C \uAC08\uAC8C.\""
    good:
    - talker: 1
      listener: 1
      face: 2
      text: "\"...\uC7A0\uAE50.\""
    - talker: 1
      listener: 1
      face: 2
      text: "\"...\uAC19\uC774 \uC788\uC5B4\uB3C4 \uC88B\uB2E4\uB294 \uB73B\uC774\uC5C8\uB2E4.\""
    - talker: 1
      listener: 1
      face: 2
      text: "\"\uB098\uC640 \uD568\uAED8 \uACE0\uB3C5 \uC18D\uC5D0\uC11C \uAE30\uB2E4\uB824\uBCF4\uC9C0
        \uC54A\uACA0\uB098?\""
    bad:
    - talker: 1
      listener: 1
      face: 1
      text: "\"...\uADF8\uB798.\""
    - talker: -1
      listener: 1
      face: 1
      text: "\"...\uBD99\uC7A1\uC744 \uC774\uC720\uB3C4 \uC5C6\uAD70.\""
