--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 644aedb8eb5027142810577af515b913, type: 3}
  m_Name: E10
  m_EditorClassIdentifier: Assembly-CSharp::Dial
  dials:
  - talker: -1
    listener: -1
    face: 0
    text: "\uD55C\uB098\uC640 \uC5F0\uC544\uAC00 \uB3D9\uC2DC\uC5D0 \uB0B4 \uC55E\uC73C\uB85C
      \uB2E4\uAC00\uC628\uB2E4."
  - talker: 0
    listener: 0
    face: 0
    text: "\"...\uC5B4?\""
  - talker: 0
    listener: 0
    face: 0
    text: "\"...\uC5F0\uC544?\""
  - talker: 2
    listener: 0
    face: 0
    text: "\"\uC557! \uD55C\uB098?\""
  - talker: 2
    listener: 0
    face: 0
    text: "\"...\uC65C \uC5EC\uAE30 \uC788\uC5B4?\""
  - talker: 0
    listener: 0
    face: 0
    text: "\"\uC124\uB9C8...\""
  - talker: 2
    listener: 0
    face: 0
    text: "\"\uC6B0\uB9AC \uB458 \uB2E4 \uACE0\uBC31\uD558\uB7EC \uC628 \uAC70\uC57C?!\""
  - talker: -1
    listener: 0
    face: 0
    text: "\uC7A0\uC2DC \uC815\uC801\uC774 \uD750\uB978\uB2E4."
  - talker: -1
    listener: 0
    face: 0
    text: "\uD55C\uB098\uC640 \uC5F0\uC544\uAC00 \uB3D9\uC2DC\uC5D0 \uB098\uB97C
      \uBC14\uB77C\uBCF8\uB2E4."
  - talker: 0
    listener: 0
    face: 0
    text: "(\uC6B8\uBA39\uC774\uBA70)\"....\uB098\uB791 \uAC19\uC774 \uBCF4\uB0C8\uB358
      \uC18C\uC911\uD55C \uC2DC\uAC04\uB4E4\uC744, \uB611\uAC19\uC774 \uC5F0\uC544\uD558\uACE0\uB3C4
      \uBCF4\uB0B4\uACE0 \uC788\uC5C8\uAD6C\uB098..\""
  - talker: 0
    listener: 0
    face: 0
    text: "\"\uC74F.. (\uB208\uBB3C\uC744 \uAC00\uB9AC\uBA70) \uD765!\""
  - talker: 0
    listener: 0
    face: 0
    text: "\"\uC774\uC81C \uB9C8\uC74C\uB300\uB85C \uD574! \uC774\uBBF8 \uB9C8\uC74C\uC744
      \uB9C8\uC74C\uB300\uB85C \uC774\uC6A9\uD588\uC73C\uB2C8\uAE4C!\""
  - talker: 0
    listener: 0
    face: 0
    text: "\"\uB09C \uAC08\uAC70\uC57C! \uB10C \uC5B4\uB5BB\uAC8C \uD560\uB798, \uC5F0\uC544?\""
  - talker: 2
    listener: 0
    face: 0
    text: "\"(\uC8FC\uBA39\uC744 \uC950\uBA70)......\uC751. \""
  - talker: 2
    listener: 0
    face: 0
    text: "\"\uB0B4\uAC00 \uBD84\uC704\uAE30 \uD30C\uC545\uC744 \uC798 \uBABB\uD560\uB54C\uB3C4
      \uC788\uC9C0\uB9CC \uC9C0\uAE08 \uC774\uAC83\uB9CC\uD07C\uC740 \uD655\uC2E4\uD558\uB124.\""
  - talker: -1
    listener: 0
    face: 0
    text: "\"\uD55C\uB098, \uC800 \uC0AC\uB78C\uC740 \uB108\uC640 \uB098 \uAC00\uC9C0\uACE0
      \uB17C \uAC70\uC600\uC5B4.\""
  - talker: 2
    listener: 0
    face: 0
    text: "\"(\uD55C\uC228 \uC26C\uBA70)......\uD55C\uB098, \uC6B0\uB9AC \uB514\uC800\uD2B8
      \uBA39\uC73C\uB7EC \uAC08\uB798?\""
  - talker: 0
    listener: 0
    face: 0
    text: "\"\uC751, \uC88B\uC544!\""
  - talker: -1
    listener: 0
    face: 0
    text: "\uB458\uC740 \uB098\uB97C \uB4A4\uB85C\uD55C \uCC44 \uB098\uB780\uD788
      \uAC78\uC5B4\uAC14\uB2E4."
  - talker: -1
    listener: 0
    face: 0
    text: ...
  - talker: -1
    listener: 0
    face: 0
    text: "\uC5B4\uC9F8 \uB458\uC774 \uB354 \uC990\uAC70\uC6CC \uBCF4\uC774\uB294
      \uAC74 \uAE30\uBD84 \uD0D3\uC77C\uAE4C."
  - talker: -1
    listener: 0
    face: 0
    text: "<BAD END - \uB458\uC774 \uB354 \uC798 \uB9DE\uB124>"
  choices: []
