%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 644aedb8eb5027142810577af515b913, type: 3}
  m_Name: Dial_8
  m_EditorClassIdentifier: Assembly-CSharp::Dial
  dials:
  - talker: -1
    listener: 0
    face: 0
    text: "(\uB4DC\uB974\uB975, \uD0C1.)"
  - talker: -1
    listener: 0
    face: 0
    text: "\uD55C\uB098\uAC00 \uAE61\uCDA9\uAE61\uCDA9 \uB6F0\uBA74\uC11C \uAD50\uC2E4\uB85C
      \uB4E4\uC5B4\uC628\uB2E4."
  - talker: 0
    listener: 0
    face: 0
    text: "\"\uD788\uD788\uD788~\""
  - talker: -1
    listener: 0
    face: 0
    text: "\uC791\uC740 \uB514\uC800\uD2B8 \uD558\uB098\uB97C \uB4E4\uACE0 \uC788\uB294\uB370,
      \uAD49\uC7A5\uD788 \uC18C\uC911\uD558\uAC8C \uB2E4\uB8E8\uACE0 \uC788\uB2E4."
  - talker: -1
    listener: 0
    face: 0
    text: "\uD55C\uCC38\uC744 \uBC14\uB77C\uBCF8 \uD6C4 \uB4DC\uB514\uC5B4 \uCCAB
      \uC785\uC744 \uBA39\uC73C\uB824\uB358 \uC21C\uAC04, \uD55C\uB098\uAC00 \uAC11\uC790\uAE30
      \uB098\uB97C \uCCD0\uB2E4\uBCF8\uB2E4."
  - talker: 0
    listener: 0
    face: 0
    text: "\"...\uBA39\uC744\uB798?\""
  - talker: 0
    listener: 0
    face: 0
    text: "\"...\uADFC\uB370 \uB9CE\uC774\uB294 \uC548 \uB3FC.\""
  - talker: -1
    listener: 0
    face: 0
    text: "\uB2E8 \uAC78 \uC88B\uC544\uD558\uB294 \uD55C\uB098\uAC00 \uB098\uD55C\uD14C
      \uCCAB \uC785\uC744 \uC591\uBCF4\uD558\uB2E4\uB2C8, \uC774\uAC74 \uB450 \uBC88
      \uB2E4\uC2DC \uC624\uC9C0 \uC54A\uC744 \uAE30\uD68C\uB2E4."
  choices:
  - text: "\"\uD55C \uC785\uB9CC \uBA39\uC744\uAC8C.\""
    good:
    - talker: -1
      listener: 0
      face: 2
      text: " (\uD3ED\uC2E0.) "
    - talker: -1
      listener: 0
      face: 2
      text: "\"\uC74C!! \uC9C4\uC9DC \uB9DB\uC788\uB2E4!\""
    - talker: -1
      listener: 0
      face: 2
      text: "\"(\uB514\uC800\uD2B8\uB97C \uD55C\uB098\uC5D0\uAC8C \uAC74\uB124\uC8FC\uBA70)
        \uB108\uAC00 \uADF8\uB807\uAC8C \uC774 \uB514\uC800\uD2B8\uB97C \uC18C\uC911\uD788
        \uC5EC\uACBC\uB358 \uC774\uC720\uB97C \uC54C\uACA0\uB2E4\u314E\u314E\""
    - talker: 0
      listener: 0
      face: 2
      text: "\"\uADF8\uCE58?!\" "
    - talker: 0
      listener: 0
      face: 2
      text: "\"(\uB208\uC774 \uBC18\uC9DD\uBC18\uC9DD \uBE5B\uB098\uBA70) \uC774\uAC70,
        \uB0B4\uAC00 \uC88B\uC544\uD558\uB294 \uBE75\uC9D1\uC5D0\uC11C \uC624\uD508\uB7F0\uD574\uC11C
        \uAD6C\uD55C\uAC70\uC57C! \uB9DB\uBCFC \uB54C\uB9C8\uB2E4 \uD56D\uC0C1 \uAE5C\uC9DD\uAE5C\uC9DD
        \uB180\uB780\uB2E4\uB2C8\uAE4C?!\""
    - talker: 0
      listener: 0
      face: 2
      text: "\"..\uD765. \uB108 \uC544\uB2C8\uC5C8\uC73C\uBA74 \uAC10\uD788 \uD55C
        \uC785 \uC548\uC92C\uC744\uAC70\uC57C. \""
    bad:
    - talker: -1
      listener: 0
      face: 1
      text: "(\uC655.)"
    - talker: 0
      listener: 0
      face: 1
      text: ...
    - talker: -1
      listener: 0
      face: 1
      text: "\uD55C \uC785\uC744 \uBA39\uACE0 \uB098\uB2C8, \uD55C\uB098\uAC00 \uAC00\uC9C0\uACE0
        \uC788\uB358 \uC791\uC740 \uB514\uC800\uD2B8\uB294 \uC628\uB370\uAC04\uB370\uB3C4
        \uC5C6\uC5B4\uC84C\uB2E4."
    - talker: -1
      listener: 0
      face: 1
      text: "\uC544\uBB34\uB798\uB3C4 \uB108\uBB34 \uB9CE\uC774 \uBA39\uC740 \uBAA8\uC591\uC774\uB2E4."
    - talker: 0
      listener: 0
      face: 3
      text: "\"\uB0B4.. \uB0B4 \uB514\uC800\uD2B8...\"\n"
    - talker: -1
      listener: 0
      face: 3
      text: "\uB208\uBB3C\uC774 \uAC00\uB4DD \uACE0\uC778 \uD55C\uB098\uC758 \uB208\uB3D9\uC790\uAC00
        \uD30C\uB974\uB974 \uB5A8\uB838\uB2E4. "
    - talker: -1
      listener: 0
      face: 3
      text: "\"\uC544..\uD55C-\""
    - talker: -1
      listener: 0
      face: 3
      text: "\uC774\uB984\uC744 \uBD80\uB974\uB824\uB358 \uC21C\uAC04, \uD55C\uB098\uB294
        \uC5BC\uAD74\uC5D0 \uB9FA\uD788\uB294 \uB208\uBB3C\uC744 \uC560\uC368 \uAC10\uCD94\uBA70
        \uAD50\uC2E4 \uBC16\uC73C\uB85C \uC7AC\uBE68\uB9AC \uB6F0\uC5B4\uB098\uAC14\uB2E4."
  - text: "\"\uB410\uC5B4. \uB124\uAC00 \uBA39\uC5B4.\""
    good:
    - talker: 0
      listener: 0
      face: 2
      text: "\"..! \uB108 \uB0B4\uAC00 \uD55C \uC785 \uC8FC\uBA74 \uC2EC\uC220\uBD80\uB9B4\uAE4C\uBD10
        \uC77C\uBD80\uB7EC \uC548 \uBA39\uB294\uAC70\uC9C0?\""
    - talker: 0
      listener: 0
      face: 2
      text: "\"\uD79B, \uC0AC\uC2E4 \uB9DE\uC544.\""
    - talker: 0
      listener: 0
      face: 2
      text: "\"\uD788\uD788 \uB0B4\uAC00 \uC5B4\uB5BB\uAC8C \uAD6C\uD55C\uAC74\uB370!
        \uC548 \uBA39\uC73C\uBA74 \uB098\uC57C \uB354 \uC88B\uC9C0! \uB098\uB97C
        '\uBC30\uB824'\uD574\uC918\uC11C \uACE0\uB9C8\uC6CC~!\""
    - talker: -1
      listener: 0
      face: 2
      text: "\uD55C\uB098\uAC00 \uB514\uC800\uD2B8 \uD55C \uC785\uC529 \uBCA0\uC5B4\uBB3C\uB54C\uB9C8\uB2E4
        \uACFC\uC7A5\uB41C \uD45C\uC815\uC744 \uC9C0\uC73C\uBA70 \uB0B4 \uCABD\uC744
        \uBCF8\uB2E4. "
    - talker: -1
      listener: 0
      face: 2
      text: "\uD55C\uB098\uAC00 \uC584\uBC09\uAC8C \uACC4\uC18D \uC7A5\uB09C\uCE58\uB294
        \uAC78 \uBCF4\uB2C8 \uB0B4 \uD589\uB3D9\uC774 \uD55C\uB098\uD55C\uD14C \uC88B\uAC8C
        \uBC1B\uC544\uB4E4\uC5EC\uC9C4 \uAC83 \uAC19\uB2E4."
    bad:
    - talker: 0
      listener: 0
      face: 1
      text: "\"(\uC12D\uC12D\uD574 \uD558\uBA70) \uC9C4\uC9DC? \uC548 \uBA39\uC744\uAC70\uC57C?\""
    - talker: 0
      listener: 0
      face: 1
      text: "\"\uCCC7.. \uADF8\uB798! \uBA39\uAE30 \uC2EB\uC73C\uBA74 \uBA39\uC9C0\uB9C8!\""
    - talker: -1
      listener: 0
      face: 1
      text: "\uD55C\uB098\uAC00 \uACE0\uAC1C\uB97C \uB3CC\uB9AC\uBA70 \uD63C\uC790\uC11C
        \uC791\uC740 \uB514\uC800\uD2B8\uB97C \uBA39\uB294\uB2E4."
  - text: "\"\uADF8\uB7FC \uBC18\uC529 \uBA39\uC790.\""
    good:
    - talker: 0
      listener: 0
      face: 2
      text: "\"...\uBC18\uC529?\""
    - talker: 0
      listener: 0
      face: 2
      text: "\"...\uC9C4\uC9DC? \uB09C \uB108\uAC00 \uB2E8 \uAC78 \uBCC4\uB85C \uC548
        \uC88B\uC544\uD558\uB294 \uC904 \uC54C\uC558\uB294\uB370!\""
    - talker: -1
      listener: 0
      face: 2
      text: "(\uC870\uC2EC\uD788 \uC791\uC740 \uB514\uC800\uD2B8\uB97C \uBC18\uC73C\uB85C
        \uC798\uB77C\uC900\uB2E4)"
    - talker: 0
      listener: 0
      face: 2
      text: "\"(\uC5BC\uAD74 \uBD89\uD788\uBA70)... \uC774 \uD06C\uB9BC\uC774 \uBC14\uAE65
        \uD06C\uB7EC\uC2A4\uD2B8\uB791 \uAC19\uC774 \uBA39\uC73C\uBA74 \uC815\uB9D0
        \uB9DB\uC788\uC5B4! \uC774\uAC74 00\uBE75\uC9D1\uC5D0\uC11C\uB9CC \uC4F0\uB294
        \uB808\uC2DC\uD53C\uC778\uB370-\""
    bad:
    - talker: 0
      listener: 0
      face: 1
      text: "\"...\uBC29\uAE08 \uC9C4\uC9DC \uAE30\uBD84 \uB098\uBE74\uC5B4. \""
    - talker: 0
      listener: 0
      face: 1
      text: "\"...\uC774\uC81C \uB2E8 \uAC70 \uBA39\uC73C\uB7EC \uAC00\uACE0 \uC2F6\uC9C0\uB3C4
        \uC54A\uC544\uC84C\uC5B4. \uD765.\""
