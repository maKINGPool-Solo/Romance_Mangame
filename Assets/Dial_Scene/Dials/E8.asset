--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 644aedb8eb5027142810577af515b913, type: 3}
  m_Name: E8
  m_EditorClassIdentifier: Assembly-CSharp::Dial
  dials:
  - talker: -1
    listener: -1
    face: 0
    text: "\uB179\uC2A4\uC640 \uC5F0\uC544\uAC00 \uB3D9\uC2DC\uC5D0 \uB0B4 \uC55E\uC73C\uB85C
      \uB2E4\uAC00\uC628\uB2E4."
  - talker: 2
    listener: 0
    face: 0
    text: "\"\uC788\uC9C0- ..\uC5E5?\""
  - talker: 1
    listener: 0
    face: 0
    text: "\"\uC5F0\uC544..? \uADF8\uB300\uAC00 \uC65C \uC5EC\uAE30\uC5D0...\""
  - talker: 1
    listener: 0
    face: 0
    text: "\"\uC124\uB9C8...\""
  - talker: 2
    listener: 0
    face: 0
    text: "\"\uC7A0\uAE50\uB9CC..\""
  - talker: 2
    listener: 0
    face: 0
    text: "\"\uC6B0\uB9AC \uB458 \uB2E4 \uACE0\uBC31\uD558\uB7EC \uC628 \uAC70\uC57C?!\""
  - talker: 1
    listener: 0
    face: 0
    text: '"..."'
  - talker: 1
    listener: 0
    face: 0
    text: "\"\uADF8\uB300\uAC00 \uB0B4 \uACC1\uC73C\uB85C \uB2E4\uAC00\uC640 \uC900
      \uC774\uC720\uB294 \uC9C4\uC2E4\uB41C \uC0AC\uB791\uC774 \uC544\uB2CC \uB180\uC74C\uC5D0
      \uAC00\uAE4C\uC6B4 \uC9D3\uC774\uC5C8\uB098..!\""
  - talker: 1
    listener: 0
    face: 0
    text: "\"(\uC8FC\uBA39\uC744 \uC950\uBA70)...\uD604\uC2E4\uC740 \uCC38\uC73C\uB85C
      \uC794\uD639\uD558\uAD70....\""
  - talker: 1
    listener: 0
    face: 0
    text: "\"\uB108\uB97C \uBBFF\uB294\uAC8C \uC544\uB2C8\uC5C8\uC5B4...!\""
  - talker: 2
    listener: 0
    face: 0
    text: "\"(\uC190\uC774 \uB5A8\uB9AC\uBA74\uC11C) \uC544..\uC544\uB2C8.. \uC9C4\uC9DC..?
      \uADF8\uB7FC \uB0B4 \uB9C8\uC74C\uB3C4 \uAC00\uC9C0\uACE0 \uC7A5\uB09C\uCE5C\uAC70\uC57C..?\""
  - talker: -1
    listener: 0
    face: 0
    text: "\uC5F0\uC544\uB294 \uC8FC\uBA39\uC744 \uBD88\uB048 \uC950\uACE0 \uBC14\uB2E5\uC744
      \uB0B4\uB9AC\uCCE4\uB2E4. \uADF8 \uCDA9\uACA9\uC73C\uB85C \uC8FC\uBCC0 \uAC74\uCD95\uBB3C\uC740
      \uD754\uB4E4\uB838\uC9C0\uB9CC \uBB34\uAC70\uC6B4 \uCE68\uBB35\uC774 \uD729\uC2F8\uC778
      \uACF5\uAC04\uC5D0 \uC788\uB358 \uC774 \uC14B\uB9CC\uD07C\uC740 \uC544\uBB34\uB7F0
      \uBBF8\uB3D9\uB3C4 \uC5C6\uC5C8\uB2E4."
  - talker: 2
    listener: 0
    face: 0
    text: "\"(\uD55C\uC228 \uC26C\uBA70) \uADF8\uB7FC \uB09C \uAC08\uB798.\""
  - talker: 1
    listener: 0
    face: 0
    text: "\"...\uB098 \uB610\uD55C.\""
  - talker: 1
    listener: 0
    face: 0
    text: "\"...\uD328\uBC30\uD55C \uC804\uC7A5\uC5D0 \uBBF8\uB828\uC740 \uB0A8\uAE30\uC9C0
      \uC54A\uB294\uB2E4.\""
  - talker: -1
    listener: 0
    face: 0
    text: "\uB450 \uC0AC\uB78C\uC740 \uB098\uB97C \uC2A4\uCCD0 \uC9C0\uB098\uAC00\uBA70
      \uB098\uB780\uD788 \uAC78\uC5B4\uAC14\uB2E4."
  - talker: -1
    listener: 0
    face: 0
    text: "\uC7A0\uC2DC \uD6C4."
  - talker: -1
    listener: 0
    face: 0
    text: "\uBA40\uB9AC\uC11C \uC5F0\uC544\uC758 \uC6C3\uC74C\uC18C\uB9AC\uC640 \uB179\uC2A4\uC758
      \uD55C\uC228\uC774 \uD568\uAED8 \uB4E4\uB824\uC654\uB2E4."
  - talker: -1
    listener: 0
    face: 0
    text: "...\uC65C \uB458\uC774 \uB354 \uCE5C\uD574\uC9C4 \uAC83 \uAC19\uC9C0?"
  - talker: -1
    listener: 0
    face: 0
    text: "<BAD END - \uACF5\uACF5\uC758 \uC801>"
  choices: []
