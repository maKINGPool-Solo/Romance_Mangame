  dials:
  - talker: -1
    listener: -1
    face: 0
    text: "\uB179\uC2A4\uAC00 \uB098\uC5D0\uAC8C \uB2E4\uAC00\uC628\uB2E4."
  - talker: 1
    listener: 0
    face: 0
    text: "\"...\uB4DC\uB514\uC5B4 \uCC3E\uC558\uAD70.\""
  - talker: 1
    listener: 0
    face: 0
    text: "\"...\uB098\uC640 \uAC19\uC740 \uAE38\uC744 \uAC78\uC744 \uC790\uB97C.\""
  - talker: -1
    listener: 0
    face: 0
    text: "\uB179\uC2A4\uAC00 \uCC9C\uCC9C\uD788 \uC190\uC744 \uB0B4\uBBFC\uB2E4."
  - talker: 1
    listener: 0
    face: 0
    text: "\"\uB098\uB294 \uC9C0\uAE08\uAE4C\uC9C0 \uD640\uB85C \uC120 \uAC80\uACFC
      \uAC19\uC558\uB2E4.\""
  - talker: 1
    listener: 0
    face: 0
    text: "\"\uADF8\uB7EC\uB098.... \uC9C0\uB09C 3\uC77C \uB3CC\uC774\uCF1C\uBD24\uC744
      \uB54C \uAE68\uB2EB\uAC8C \uB418\uC5C8\uB2E4.\""
  - talker: 1
    listener: 0
    face: 0
    text: "\"\uB0B4 \uBC29\uC2DD\uC744 \uC774\uD574\uD574\uC8FC\uB294 \uB4E0\uB4E0\uD55C
      \uBC29\uD328\uAC19\uC740 \uC874\uC7AC\uAC00 \uC788\uC5C8\uB2E4\uB294 \uAC83\uC744.\""
  - talker: 1
    listener: 0
    face: 0
    text: "\"(\uC6C3\uC73C\uBA74\uC11C)..\uC55E\uC73C\uB85C\uB3C4 \uB098\uC640 \uAC19\uC740
      \uAE38\uC744 \uAC77\uB294 \uC790\uAC00 \uB418\uC5B4\uC8FC\uC9C0 \uC54A\uACA0\uB098..?\""
  - talker: -1
    listener: 0
    face: 0
    text: "<NOX END - \uAC80\uC740 \uD63C\uC790\uAC00 \uC544\uB2C8\uB2E4>"
  choices: []
